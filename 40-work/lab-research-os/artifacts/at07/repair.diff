+def bind_stream(path,*,root,expected_hash,captured,truncated,max_bytes=65536,safety_withheld=False):
+    p=Path(path);root=Path(root).resolve()
+    out={'path':str(p),'captured':captured,'truncated':truncated,'complete':False,'status':'UNKNOWN','encoding':None}
+    try:
+        if not p.resolve().is_relative_to(root):out['status']='OUT_OF_SCOPE';return out
+        if captured is not True:out['status']='NOT_CAPTURED';return out
+        if not p.is_file():out['status']='MISSING';return out
+        size=p.stat().st_size;out['bytes']=size
+        if size>max_bytes:out['status']='OVERSIZED';return out
+        b=p.read_bytes();digest=hashlib.sha256(b).hexdigest();out.update(bytes=len(b),sha256=digest,expected_sha256=expected_hash)
+        if not isinstance(expected_hash,str) or not re.fullmatch('[0-9a-f]{64}',expected_hash):out['status']='UNBOUND';return out
+        if digest!=expected_hash:out['status']='TAMPERED';return out
+        if truncated is not False:out['status']='TRUNCATED' if truncated is True else 'CAPTURE_UNKNOWN';return out
+        try:text=b.decode('utf-8')
+        except UnicodeDecodeError:out['status']='INVALID_ENCODING';return out
+        out['encoding']='utf-8'
