{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conflict pilot v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "configured",
        "observed",
        "tested",
        "currently-live",
        "unknown"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kind": {
      "const": "conflict"
    },
    "concern": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "candidate",
        "confirmed",
        "resolved",
        "unknown"
      ]
    },
    "next_check": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "label",
    "observed_at",
    "status",
    "evidence_ids",
    "facts",
    "unknowns",
    "kind",
    "concern",
    "classification",
    "next_check"
  ],
  "additionalProperties": false
}
