+def review_gate(wrapper,exit_code):
+    try:
+        if not isinstance(wrapper,dict) or exit_code!=0:return 'UNCERTAIN'
+        if wrapper.get('reason',{}).get('kind')!='completed' or type(wrapper.get('tool_calls')) is not int or wrapper['tool_calls']!=0:return 'UNCERTAIN'
+        report=json.loads(wrapper['text'])
+        if not all(isinstance(report.get(k),str) and report[k] for k in ['claim','evidence','verification_method']):return 'UNCERTAIN'
+        score=report.get('confidence')
+        if type(score) not in [int,float] or not 0<=score<=1:return 'UNCERTAIN'
+        if not isinstance(report.get('anomaly_conflict'),list) or not isinstance(report.get('limitations'),list):return 'UNCERTAIN'
+        if report.get('result') not in ['PASS','FAIL','UNCERTAIN']:return 'UNCERTAIN'
+        if report['anomaly_conflict'] or report['result']=='FAIL':return 'FAIL'
+        return 'PASS' if report['result']=='PASS' and score>=.80 else 'UNCERTAIN'
+    except (KeyError,TypeError,ValueError,AttributeError):return 'UNCERTAIN'
