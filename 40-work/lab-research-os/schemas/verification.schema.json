{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "verification_method": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNCERTAIN"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "anomaly_conflict": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "model_reported": {
      "type": "string",
      "minLength": 1
    },
    "harness": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "claim",
    "evidence_ids",
    "verification_method",
    "result",
    "confidence",
    "anomaly_conflict",
    "reviewer",
    "model_reported",
    "harness",
    "observed_at"
  ],
  "additionalProperties": false
}
