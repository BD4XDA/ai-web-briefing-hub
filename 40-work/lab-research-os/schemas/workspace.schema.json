{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workspace pilot v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "configured",
        "observed",
        "tested",
        "currently-live",
        "unknown"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kind": {
      "const": "workspace"
    },
    "root_path": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "enum": [
        "bounded-sample",
        "unknown"
      ]
    },
    "sampled_files": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "label",
    "observed_at",
    "status",
    "evidence_ids",
    "facts",
    "unknowns",
    "kind",
    "root_path",
    "coverage",
    "sampled_files",
    "duplicate_candidates"
  ],
  "additionalProperties": false
}
