{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lab Research OS capability registry v1",
  "type": "object",
  "required": ["registry_version", "updated_at", "policy", "capabilities"],
  "properties": {
    "registry_version": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "policy": {
      "type": "object",
      "required": ["selection", "update_check", "automatic_upgrade"],
      "properties": {
        "selection": {"const": "need-driven"},
        "update_check": {"const": "weekly-and-before-use"},
        "automatic_upgrade": {"const": false}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "tier", "availability", "qualification", "workloads", "trigger", "source", "update_policy", "last_verified", "evidence", "fallback"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1},
          "kind": {"enum": ["skill", "mcp", "harness", "profile", "toolchain", "router", "control-plane"]},
          "tier": {"enum": ["core", "on-demand", "watch-only", "excluded"]},
          "availability": {"enum": ["installed", "configured", "live", "offline", "unknown"]},
          "qualification": {"enum": ["unverified", "partial", "qualified", "blocked", "not-required"]},
          "workloads": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "trigger": {"enum": ["TIME", "EVENT", "MILESTONE", "STATE", "ON_DEMAND"]},
          "source": {"type": "string", "minLength": 1},
          "current_version": {"type": ["string", "null"]},
          "update_policy": {"enum": ["manual-review", "runtime-managed", "pinned", "no-update"]},
          "last_verified": {"type": ["string", "null"], "format": "date-time"},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "fallback": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
