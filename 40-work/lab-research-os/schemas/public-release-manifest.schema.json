{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lab-research-os/public-release-manifest.schema.json",
  "title": "Lab Research OS public release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_name", "version", "license_spdx", "license_source", "forbidden_terms", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "release_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1},
    "license_spdx": {"type": ["string", "null"], "minLength": 1},
    "license_source": {"type": ["string", "null"], "minLength": 1},
    "forbidden_terms": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
