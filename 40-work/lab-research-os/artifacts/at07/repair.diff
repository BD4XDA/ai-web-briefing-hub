+                if typ in DIAGNOSTIC:kind='diagnostic'
+                elif typ in PASSIVE:kind='passive'
+                elif typ in ACTION and isinstance(ident,str) and ident:
+                    kind='action'
+                    if ident in actions and actions[ident]['item']['type']!=typ:kind='unknown'
+                    else:
+                        a=actions.setdefault(ident,{'id':ident,'indices':[],'completed':False})
+                        a['indices'].append(index);a['item']=item;a['completed']=et=='item.completed'
