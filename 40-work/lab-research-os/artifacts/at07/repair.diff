+ACTION={'command_execution','mcp_tool_call','web_search','file_change'}
+DIAGNOSTIC={'error','warning'}
+PASSIVE={'agent_message','reasoning','plan'}
+def normalize(events):
+    out={'actions':[],'diagnostics':[],'unknown':[],'order':[]}
+    actions={}
+    for index,event in enumerate(events):
+        kind='unknown'; payload=event
+        if isinstance(event,dict):
+            et=event.get('type')
+            if et in {'thread.started','turn.started','turn.completed'}:kind='lifecycle'
+            elif et in {'error','warning','turn.failed'}:kind='diagnostic'
+            elif et in {'item.started','item.updated','item.completed'} and isinstance(event.get('item'),dict):
