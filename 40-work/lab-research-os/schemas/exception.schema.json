{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exception v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "conflicting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "possible_explanations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "consequence": {
      "type": "string",
      "minLength": 1
    },
    "recommended_next_check": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "problem",
    "evidence_ids",
    "conflicting_evidence_ids",
    "attempts",
    "confidence",
    "possible_explanations",
    "consequence",
    "recommended_next_check",
    "level",
    "owner"
  ],
  "additionalProperties": false
}
