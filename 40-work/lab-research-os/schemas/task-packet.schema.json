{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-packet v1",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "const": "lab-research-os"
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "expected_checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "allowed_read_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "write_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "excluded_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "input_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "verification_route": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "budget v1",
      "type": "object",
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "max_files",
        "max_depth",
        "max_model_calls"
      ],
      "additionalProperties": false
    },
    "resume_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "task_id",
    "project_id",
    "project_root",
    "expected_checkpoint",
    "owner",
    "objective",
    "allowed_read_roots",
    "write_paths",
    "excluded_scope",
    "input_evidence_ids",
    "acceptance_criteria",
    "verification_route",
    "budget",
    "resume_action"
  ],
  "additionalProperties": false
}
