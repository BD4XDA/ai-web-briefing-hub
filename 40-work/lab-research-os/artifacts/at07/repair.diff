+        if safety_withheld or re.search(r'sk-[A-Za-z0-9_-]{16,}|Bearer\s+[A-Za-z0-9._-]{16,}|-----BEGIN .*PRIVATE KEY-----',text):out['status']='WITHHELD_SAFETY';return out
